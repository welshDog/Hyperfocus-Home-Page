# WelshDog Designs — environment variables
# Copy to .env.local and fill in. Do NOT commit .env.local.

# Supabase (Database + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 2 — card payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Teemill print-on-demand fulfilment (apparel)
TEEMILL_PUBLIC_KEY=
TEEMILL_PRIVATE_KEY=
TEEMILL_STORE=
# Store/project slug used by the Teemill Orders API ?project= param.
TEEMILL_PROJECT_NAME=
# MOCK GATE — must be exactly "true" to confirm REAL Teemill orders.
# Leave unset/false to build + test the flow safely (no real orders placed).
TEEMILL_LIVE=false

# Etsy Open API v3 key — get free at https://www.etsy.com/developers/register
ETSY_API_KEY=

# Admin access — comma-separated allowlist of admin emails
ADMIN_EMAILS=your@email.com
# Owner inbox for order-fulfilment alerts (falls back to first ADMIN_EMAILS).
ADMIN_EMAIL=

# Transactional email (Phase 4 — lead confirmations)
RESEND_API_KEY=

# Public site URL (used for OG images, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://welshdog.designs
